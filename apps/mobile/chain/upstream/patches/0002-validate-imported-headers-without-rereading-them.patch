--- a/chainimport/licash_validate_test.go
+++ b/chainimport/licash_validate_test.go
@@ -0,0 +1,124 @@
+package chainimport
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/btcsuite/btcd/blockchain"
+	"github.com/btcsuite/btcd/chaincfg/v2"
+	"github.com/btcsuite/btcd/wire/v2"
+	"github.com/lightninglabs/neutrino/headerfs"
+	"github.com/stretchr/testify/require"
+)
+
+// licashChain is n simnet headers from height 0, half an hour apart but for
+// the header at back, whose timestamp is ago before its predecessor's. More
+// than twice simnet's block time apart, a header's difficulty is found with
+// no walk back to the last retarget (ReduceMinDifficulty).
+func licashChain(n, back int, ago time.Duration) []*blockHeader {
+	headers := make([]*blockHeader, n)
+	base := time.Unix(1700000000, 0)
+	for i := range headers {
+		ts := base.Add(time.Duration(i) * 30 * time.Minute)
+		if i == back {
+			ts = base.Add(time.Duration(i-1)*30*time.Minute - ago)
+		}
+		hdr := &wire.BlockHeader{
+			Version:   0x20000000,
+			Bits:      chaincfg.SimNetParams.PowLimitBits,
+			Timestamp: ts,
+		}
+		if i > 0 {
+			hdr.PrevBlock = headers[i-1].BlockHeader.BlockHash()
+		}
+		// Simnet's proof of work: half of all hashes.
+		for {
+			hash := hdr.BlockHash()
+			if blockchain.HashToBig(&hash).Cmp(
+				chaincfg.SimNetParams.PowLimit) <= 0 {
+
+				break
+			}
+			hdr.Nonce++
+		}
+		headers[i] = &blockHeader{BlockHeader: headerfs.BlockHeader{
+			BlockHeader: hdr, Height: uint32(i),
+		}}
+	}
+	return headers
+}
+
+// licashValidate validates headers, all in the import source, with the
+// target store holding the first one only, in batches of batch.
+func licashValidate(t *testing.T, headers []*blockHeader,
+	batch uint32) (*mockHeaderImportSource, error) {
+
+	n := uint32(len(headers))
+	source := &mockHeaderImportSource{}
+	source.On("GetHeaderMetadata").Return(&headerMetadata{
+		importMetadata: &importMetadata{startHeight: 0},
+		headersCount:   n,
+	}, nil)
+	for i, h := range headers {
+		source.On("GetHeader", uint32(i)).Return(h, nil)
+	}
+
+	// The store answers for its tip only: an ancestor above it asked
+	// of the store fails the test.
+	store := &headerfs.MockBlockHeaderStore{}
+	store.On("ChainTip").Return(headers[0].BlockHeader.BlockHeader,
+		uint32(0), nil)
+	store.On("FetchHeaderByHeight", uint32(0)).Return(
+		headers[0].BlockHeader.BlockHeader, nil)
+
+	v := newBlockHeadersImportSourceValidator(
+		chaincfg.SimNetParams, store, blockchain.BFNone, source,
+	)
+	it := &importSourceHeaderIterator{
+		source: source, startIndex: 0, endIndex: n - 1,
+		batchSize: batch,
+	}
+	return source, v.Validate(context.Background(), it)
+}
+
+// TestValidateReadsEachImportedHeaderOnce: the median time of each header
+// takes its ancestors above the store's tip from the headers already read,
+// not from the store nor the import source again, and still checks it.
+func TestValidateReadsEachImportedHeaderOnce(t *testing.T) {
+	t.Parallel()
+
+	for _, batch := range []uint32{5, 64} {
+		t.Run(fmt.Sprint(batch), func(t *testing.T) {
+			headers := licashChain(40, -1, 0)
+			source, err := licashValidate(t, headers, batch)
+			require.NoError(t, err)
+			source.AssertNumberOfCalls(t, "GetHeader", len(headers))
+
+			// 75 minutes back: still after the median of the
+			// eleven before it, as on mainnet and signet. Simnet
+			// then walks back to height 0 for its difficulty.
+			headers = licashChain(40, 30, 75*time.Minute)
+			_, err = licashValidate(t, headers, batch)
+			require.NoError(t, err)
+		})
+	}
+}
+
+// TestValidateStillRefusesATimestampAtTheMedian: a header no later than the
+// median time of its eleven ancestors, all read from the import source, is
+// refused.
+func TestValidateStillRefusesATimestampAtTheMedian(t *testing.T) {
+	t.Parallel()
+
+	for _, batch := range []uint32{5, 64} {
+		t.Run(fmt.Sprint(batch), func(t *testing.T) {
+			// Header 30's median is header 24's timestamp, 150
+			// minutes before header 29's: 180 back is header 23's.
+			headers := licashChain(40, 30, 180*time.Minute)
+			_, err := licashValidate(t, headers, batch)
+			require.ErrorContains(t, err, "is not after expected")
+		})
+	}
+}
